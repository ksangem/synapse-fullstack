# Database
DATABASE_URL=postgresql://synapse:synapse@localhost:5432/synapse_db
REDIS_URL=redis://localhost:6379

# Encryption (32-byte hex)
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Jira — Flatiron (MFA via Playwright)
FLATIRON_JIRA_URL=https://flatironhealth.atlassian.net
FLATIRON_JIRA_EMAIL=your_jira_email@domain.com
FLATIRON_JIRA_PASSWORD=your_password
FLATIRON_JIRA_TOTP_SECRET=your_totp_secret_for_mfa

# Jira — Red Gold (API Token)
RED_GOLD_JIRA_URL=https://redgoldfoods.atlassian.net
RED_GOLD_JIRA_EMAIL=your_jira_email@domain.com
RED_GOLD_JIRA_API_TOKEN=your_api_token

# Azure / SharePoint
AZURE_CLIENT_ID=your_azure_client_id
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# App
NODE_ENV=development
PORT=4000
FRONTEND_PORT=5173

# Data retention (nightly sweep at 03:30 — workers/retentionWorker.ts)
# Values are DAYS. Set 0 to disable sweeping that table entirely.
# Only safe rows are ever removed: inbox/outbox must be status 'done', dead letters must
# already have been replayed, and never-replayed failures are kept regardless of age.
INBOX_RETENTION_DAYS=30
OUTBOX_RETENTION_DAYS=30
RUN_MESSAGE_RETENTION_DAYS=30
# Duplicate-suppression ledger: purging an entry lets a replayed message deliver twice,
# so keep this >= the longest gap before you would ever replay from the DLQ.
IDEMPOTENCY_RETENTION_DAYS=90
DLQ_RETENTION_DAYS=90
# Audit log is compliance evidence (BRD 7.8) — sweeping is OFF unless you set this.
AUDIT_RETENTION_DAYS=0
